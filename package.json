{
  "name": "@runzhi214/dsh-jev-suggest",
  "description": "Next-action suggestion bar for DSH — per-turn candidate generation plus decision-model probability scoring, shown as clickable chips above the composer",
  "version": "0.0.1-beta.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runzhi214/dsh-jev-suggest.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint ."
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": ">=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-0 <0.3.0-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "@vitest/coverage-v8": "^2.1.0",
    "oxlint": "^0.15.0",
    "react": "^18.2.0",
    "tsdown": "^0.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml"
  ]
}
